# Kafka connection settings for SigmoScan. Copy this file to .env and fill it in.
# Do not put quotes around the values (docker run --env-file keeps them).
# An environment variable with the same name takes priority over this file.

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=network

# Required when SASL_MECHANISM=PLAIN in config.ini
KAFKA_SASL_USERNAME=admin
KAFKA_SASL_PASSWORD=admin

# Only used when SECURITY_PROTOCOL=SASL_SSL in config.ini.
# Relative paths start from the folder of config.ini. Leave empty if not used.
KAFKA_CA_FILE=
KAFKA_CERT_FILE=
KAFKA_KEY_FILE=
KAFKA_KEY_PASSWORD=
