# SigmoScan connection settings for the test broker in this folder.
# TEST ONLY: these credentials are public.
# Use with: uv run main.py --envfile testutils/kafka-sasl-ssl/sigmoscan.env
#      or: docker run --env-file testutils/kafka-sasl-ssl/sigmoscan.env ...
# Paths are relative to the folder of config.ini (the root of the repository, or /app in Docker).
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=network
KAFKA_SASL_USERNAME=sigmoscan
KAFKA_SASL_PASSWORD=sigmoscan-secret
KAFKA_CA_FILE=testutils/kafka-sasl-ssl/sigmoscan/kafka-ca-1.crt
KAFKA_CERT_FILE=testutils/kafka-sasl-ssl/sigmoscan/sigmoscan.certificate.pem
KAFKA_KEY_FILE=testutils/kafka-sasl-ssl/sigmoscan/sigmoscan.key
KAFKA_KEY_PASSWORD=sigmoscan-key-password
